{
	"extends": "@sapphire/ts-config",
	"compilerOptions": {
	  	"target": "es2022",
	  	"experimentalDecorators": true,
	  	"lib": ["ES2022"],
	  	"rootDir": "src",
	  	"outDir": "dist",
	  	"tsBuildInfoFile": "dist/.tsbuildinfo",
	  	"baseUrl": ".",
	  	"resolveJsonModule": true,
	  	"composite": true,
		"skipLibCheck": true,
		"moduleResolution": "NodeNext",
		"types": ["node", "jest"]
	},
	"include": ["src"],
	"exclude": ["node_modules"]
  }