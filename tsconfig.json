{
	"extends": "./node_modules/@sapphire/ts-config/src/tsconfig.json",
	"compilerOptions": {
	  	"target": "es2022",
	  	"experimentalDecorators": true,
	  	"lib": ["ES2022"],
	  	"rootDir": "src",
	  	"outDir": "dist",
	  	"tsBuildInfoFile": "dist/.tsbuildinfo",
	  	"resolveJsonModule": true,
	  	"composite": true,
		"skipLibCheck": true,
		"module": "nodenext",
		"moduleResolution": "NodeNext",
		"types": ["node", "jest"]
	},
	"include": ["src"],
	"exclude": ["node_modules"]
  }