{
	"extends": "@sapphire/ts-config",
	"compilerOptions": {
	  	"target": "ES2024",
	  	"experimentalDecorators": true,
	  	"lib": ["DOM"],
	  	"rootDir": "src",
	  	"outDir": "dist",
	  	"tsBuildInfoFile": "dist/.tsbuildinfo",
	  	"baseUrl": ".",
	  	"resolveJsonModule": true,
	  	"composite": true,
		"skipLibCheck": true,
		"moduleResolution": "NodeNext"
	},
	"include": ["src"],
	"exclude": ["node_modules"]
  }