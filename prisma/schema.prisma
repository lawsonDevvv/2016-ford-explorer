datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model Suggestion {
  id            String   @id @unique
  type          String   @default("???")
  author        String
  createdAt     DateTime @default(now())
  suggestion    String
  reason        String
  editedBy      String   @default("Nobody")
  editedAt      DateTime @updatedAt
  status        String   @default("Pending")
  staffResponse String   @default("N/A")
  messageId     String   @default("N/A")
}

model Counting {
  server         String   @id @unique
  currentNumber  Int
  lastCounter    String
  countedAt      DateTime
  countingRecord Int      @default(0)
}

model Giveaway {
  id           Int                   @id @default(autoincrement())
  channelId    String
  guildId      String
  messageId    String?
  prize        String
  winners      Int
  endsAt       DateTime
  status       Int                   @default(1) // See @util/types/GiveawayStatus.ts
  createdAt    DateTime              @default(now())
  participants GiveawayParticipant[]
  host         String
}

model GiveawayParticipant {
  id         Int    @id @default(autoincrement())
  giveawayId Int
  userId     String

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId]) // Ensures a user can participate only once in a giveaway
}

model Case {
  id          Int      @id @unique @default(autoincrement())
  createdAt   DateTime @default(now())
  editedAt    DateTime @updatedAt @default(now())
  guild       String
  user        String
  type        Int
  reason      String?  @default("No reason provided")
  staffMember String
  status      Int      @default(0) // 0 = Open, 1 = Closed, Rescinded = 2
}

model TicketSettings {
  id            Int    @id @unique @default(autoincrement())
  guild         String @unique
  ticketCounter Int    @default(0)
  logsChannel   String @default("0")
}

model Ticket {
  id           Int       @id @unique @default(autoincrement())
  user         String
  guild        String
  type         String
  channel      String
  number       Int
  claimedBy    String?
  closedBy     String?
  closedAt     DateTime?
  closedReason String?
  transcript   Json?
  status       Int       @default(0) // 0 = Open, 1 = Closed, // 2 = Deleted

  @@unique([guild, number])
}

model BackupCode {
  id        Int      @id @unique @default(autoincrement())
  createdAt DateTime @default(now())
  userId    String   @unique
  code      String   @unique
}
