datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model Suggestion {
  id            String   @id @unique
  type          String   @default("???")
  author        String
  createdAt     DateTime @default(now())
  suggestion    String
  reason        String
  editedBy      String   @default("Nobody")
  editedAt      DateTime @updatedAt
  status        String   @default("Pending")
  staffResponse String   @default("N/A")
  messageId     String   @default("N/A")
}

model Counting {
  server         String   @id @unique
  currentNumber  Int
  lastCounter    String
  countedAt      DateTime
  countingRecord Int      @default(0)
}

model Giveaway {
  id           Int                   @id @default(autoincrement())
  channelId    String
  guildId      String
  messageId    String?
  prize        String
  winners      Int
  endsAt       DateTime
  status       Int                   @default(1) // See @util/types/GiveawayStatus.ts
  createdAt    DateTime              @default(now())
  participants GiveawayParticipant[]
  host         String
}
