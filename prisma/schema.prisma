datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model Suggestion {
  id         String   @id @unique
  author     String
  createdAt  DateTime @default(now())
  suggestion String
  reason     String
  editedBy   String   @default("Nobody")
  editedAt   DateTime @updatedAt
  status     String   @default("Pending")
}
